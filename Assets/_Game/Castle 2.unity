  m_text: "\u041F\u0435\u0440\u0435\u0445\u043E\u0434 \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
    \u0441\u043F\u0430\u0432\u043D\n\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
    \u0420\u044B\u0446\u0430\u0440\u044F \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0439\u0442\u0438\n\u0427\u0443\u0434\u0438\u0449\u0435
    \u043D\u0435 \u0437\u0430\u0445\u043E\u0447\u0435\u0442 \u0441 \u043D\u0430\u043C\u0438
    \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0441\u043A\u0430\u0437\u0430\u0432
    \u0447\u0442\u043E \u043C\u044B \u043B\u044E\u0442\u044B\u0439 \u0438 \u0443\u0431\u0435\u0436\u0438\u0442,
    \u0430 \u0437\u0430\u0442\u0435\u043C \u043C\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C
    \u0435\u0433\u043E \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u043C \u0441\u043F\u0430\u0432\u043D\u0435\n\u0412
    \u043A\u043E\u043D\u0446\u0435 \u043D\u0430\u0448\u0435\u0439 \u0431\u0438\u0442\u0432\u044B
    \u0440\u044B\u0446\u0430\u0440\u044C \u0440\u0435\u0448\u0438\u0442\u044C \u0443\u0439\u0442\u0438
    \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u041E\u043D \u043F\u043E\u043F\u0440\u043E\u0449\u0430\u0435\u0442\u0441\u044F
    \u0441 \u0441\u043E\u0431\u0430\u0447\u043A\u043E\u0439.\n\u0418 \u043C\u044B
    \u0441\u043C\u043E\u0436\u0435\u043C \u043F\u043E\u0439\u0442\u0438 \u0432\u043F\u0440\u0430\u0432\u043E.\n\u0412
    \u043A\u043E\u043D\u0446\u0435 \u043D\u0430 \u0441\u043F\u0430\u0432\u043D\u0435
    \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F  \u0447\u0442\u043E \u0425\u0435\u0440\u043E\u0431\u0440\u0438\u043D
    \u0443\u0436\u0435 \u0443\u043A\u0440\u0430\u043B \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u043E\u0436\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044C
    \u043C\u043E\u0431\u0430\u043C \u0418\u0418. \u0410 \u0438\u0433\u0440\u043E\u043A

  m_Name: 
  m_EditorClassIdentifier: 
  _dialogues:
  - "\u042D\u0442\u043E \u0447\u044C\u044F-\u0442\u043E \u0434\u0438\u043F\u043B\u043E\u043C\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430."
  - "\u041F\u043E \u043A\u0430\u043A\u043E\u043C\u0443-\u0442\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044E
    \u0442\u0430\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043D \u043A\u043E\u0434
    \u0441\u0442\u0430\u0440\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u0433\u0440\u044B."
  - "(\u041E\u043D\u0430 \u0431\u044B\u043B\u043E \u043D\u0435 \u043E\u0447\u0435\u043D\u044C.)"
  - "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435."
  _alternativeDialogues: []
  _isDown: 0
